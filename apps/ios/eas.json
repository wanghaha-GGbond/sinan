{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.sinanapp.cn",
        "EXPO_PUBLIC_LAUNCH_SCOPE_ONLY": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sinanapp.cn",
        "EXPO_PUBLIC_LAUNCH_SCOPE_ONLY": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
