# Public HTTPS origin of the deployed Web API. Configure this as an EAS
# environment variable for preview and production builds.
EXPO_PUBLIC_API_URL=https://api.your-sinan-domain.example
EXPO_PUBLIC_LAUNCH_SCOPE_ONLY=true
# Issued mainland APP/ICP filing number, required for the production profile.
EXPO_PUBLIC_APP_FILING_NUMBER=YOUR_ISSUED_APP_FILING_NUMBER
# Public support mailbox shown in the app and App Store support page.
EXPO_PUBLIC_SUPPORT_EMAIL=support@sinanapp.cn
# Created by `eas init`; do not use a placeholder in a release environment.
EXPO_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
# App Store Connect app numeric ID, used by the production submit profile.
EXPO_ASC_APP_ID=YOUR_ASC_APP_ID
