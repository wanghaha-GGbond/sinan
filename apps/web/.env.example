# ─── Sinan web app env ──────────────────────────────────────────────
# Copy this file to `.env.local` (Next.js auto-loads), or set
# the variables in your deploy environment. `npm run build` and
# `next start` will refuse to start without AUTH_SECRET in
# production; in dev, a hardcoded fallback is used.

# Required in production. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Optional. When set, server actions and API routes that talk
# to Postgres use this DSN. Leave empty in dev if you only need
# the home / ranking / recommendation pages (those fall back to
# mock data when no DB is configured).
DATABASE_URL=

# Tests against disposable local PostgreSQL may set this to node-postgres.
# Leave unset in staging/production to use the Neon WebSocket adapter.
# DATABASE_DRIVER=node-postgres

# Required for invite-only beta. Set to true to reject registrations
# that do not provide an unused invite code.
INVITE_REQUIRED=true

# Required for work-email verification in production.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_DOMAIN=

# Required by authenticated cron endpoints.
CRON_SECRET=

# Required in staging and production. Receives sanitized server error events;
# request bodies, headers, cookies and query strings are never included.
ERROR_REPORTING_WEBHOOK=
ERROR_REPORTING_TOKEN=

# Public production contact points used by legal pages and App Store metadata.
NEXT_PUBLIC_APP_URL=
SUPPORT_EMAIL=

# Immutable deployment identifier used to correlate errors and rollbacks.
# Set this to the git commit SHA or deployment version.
APP_RELEASE=

# Public deployment metadata used by runtime feature checks.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_ENABLED=true

# Required for the invite-only launch. Returns 404 for deferred auction,
# circles and direct-message pages/APIs while those features keep developing.
LAUNCH_SCOPE_ONLY=true

# Optional. NODE_ENV is set automatically by next. Override
# only when needed (e.g. `NODE_ENV=development npm run start`).
# NODE_ENV=production

# Optional. Used by the company-portal E2E tests to bypass
# auth. NOT a real secret in any deployed environment.
PLAYWRIGHT_AUTH_TOKEN=
# Local preview accounts are disabled by default. Never set this in staging or
# production.
ALLOW_DEV_AUTH=false
