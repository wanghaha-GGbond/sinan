{
  "name": "@sinan/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "CLOUDFLARE=1 NEXT_PUBLIC_APP_ENV=staging NEXT_PUBLIC_API_ENABLED=true NEXT_PUBLIC_PULSE_ENABLED=true LAUNCH_SCOPE_ONLY=true opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:integration": "node scripts/require-database-url.mjs && playwright test --config=playwright.integration.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "release:check-env": "node scripts/check-release-env.mjs",
    "test:e2e": "playwright test tests/smoke.spec.ts",
    "test:e2e:legacy": "playwright test tests/sinan.spec.ts",
    "test:e2e:release": "node scripts/require-database-url.mjs && playwright test --config=playwright.release.config.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:verify:postgres": "bash scripts/verify-migrations-postgres.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:research": "node scripts/build-research-seed.mjs",
    "db:seed:research:validate": "node scripts/validate-research-seed.mjs",
    "research:collect": "node scripts/collect-company-research.mjs",
    "research:login:boss": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --login-setup --platform=boss_zhipin",
    "research:login:boss:system": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --login-setup --platform=boss_zhipin --system-browser",
    "research:login:xhs": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --login-setup --platform=xiaohongshu",
    "research:login:weibo": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --login-setup --platform=weibo",
    "research:login:zhihu": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --login-setup --platform=zhihu",
    "research:collect:boss": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --screenshots --manual-verify --platform=boss_zhipin",
    "research:collect:xhs": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --platform=xiaohongshu",
    "research:collect:weibo": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --platform=weibo",
    "research:collect:zhihu": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --platform=zhihu",
    "research:collect:recent:xhs": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --allow-assets --page-wait=5000 --platform=xiaohongshu --query-suffix=2026",
    "research:collect:recent:weibo": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --details --detail-limit=2 --detail-timeout=9000 --platform=weibo --query-suffix=2026",
    "research:collect:recent:zhihu": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --details --detail-limit=1 --detail-timeout=9000 --platform=zhihu --query-suffix=2026",
    "research:collect:themes:xhs": "npm run research:collect:recent:xhs -- --query-suffix='2026 下午茶 零食 食堂 加班 双休 裁员 优化'",
    "research:collect:themes:weibo": "npm run research:collect:recent:weibo -- --query-suffix='2026 下午茶 零食 食堂 加班 双休 裁员 优化 HC冻结 绩效淘汰'",
    "research:collect:themes:zhihu": "npm run research:collect:recent:zhihu -- --query-suffix='2026 下午茶 零食 食堂 加班 双休 裁员 优化 HC冻结 绩效淘汰'",
    "research:collect:themes": "npm run research:collect:themes:xhs && npm run research:collect:themes:weibo && npm run research:collect:themes:zhihu",
    "research:collect:details": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --details --detail-limit=1 --detail-timeout=7000 --platforms=xiaohongshu,weibo,zhihu",
    "research:collect:details:weibo": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --details --detail-limit=1 --detail-timeout=7000 --platform=weibo",
    "research:backfill:social-gaps": "node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --platform=xiaohongshu --company=招商银行,平安集团,蚂蚁集团 && node scripts/collect-company-research.mjs --user-data-dir=.research-browser --screenshots --platform=zhihu --company=小红书,中信证券",
    "research:backfill:boss-gaps": "node scripts/collect-company-research.mjs --headed --user-data-dir=.research-browser --screenshots --manual-verify --platform=boss_zhipin --company=字节跳动,腾讯",
    "research:report": "node scripts/build-research-report.mjs",
    "research:recent-report": "node scripts/build-recent-social-review.mjs",
    "research:insights": "node scripts/build-company-insight-cards.mjs",
    "research:indices": "node scripts/build-company-indices-v3.mjs",
    "research:indices:v2": "node scripts/build-company-indices.mjs",
    "research:db:publish": "node scripts/publish-research-index-v3.mjs",
    "research:test:algorithm": "node --test scripts/research-index-v3.test.mjs",
    "research:reports": "npm run research:insights && npm run research:indices && npm run research:recent-report && npm run research:report && npm run research:db:sync",
    "research:db:init": "python3 scripts/research_store.py init",
    "research:db:sync": "python3 scripts/research_store.py sync",
    "research:db:summary": "python3 scripts/research_store.py summary",
    "research:db:company": "python3 scripts/research_store.py company",
    "research:db:history": "python3 scripts/research_store.py history",
    "research:db:gaps": "python3 scripts/research_store.py gaps",
    "research:db:search": "python3 scripts/research_store.py search",
    "research:db:recent": "python3 scripts/research_store.py recent",
    "research:db:review": "python3 scripts/research_store.py review",
    "research:pipeline": "npm run research:collect:xhs && npm run research:collect:zhihu && npm run research:collect:details:weibo && npm run research:insights && npm run research:db:sync"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.5",
    "@alicloud/dm20151123": "^1.10.2",
    "@alicloud/openapi-client": "^0.4.15",
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "8.22.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.132.0"
  }
}
