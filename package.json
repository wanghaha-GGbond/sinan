{
  "name": "sinan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:release": "npm audit --omit=dev --audit-level=high",
    "dev:web": "npm run dev --workspace=@sinan/web",
    "dev:ios": "npm run dev --workspace=@sinan/ios",
    "build:web": "npm run build --workspace=@sinan/web"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "1.1.18",
    "hono": "4.12.27",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-svg": "15.15.4",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "undici": "6.28.0"
  }
}
