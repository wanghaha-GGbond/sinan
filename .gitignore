# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules
/packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/apps/*/.next/
/out/

# production
/build
/apps/*/build
/apps/*/dist
/apps/*/.build
/apps/*/.expo
/apps/*/ios
/apps/*/test-results

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!/apps/ios/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/

# mavis (local AI assistant runtime)
.mavis/

# opencode (local AI coding tool runtime)
.opencode/

# sinan research seed local outputs
/apps/web/src/db/seeds/research-targets.json
/apps/web/src/db/seeds/research-companies.json
/apps/web/src/db/seeds/research-companies.generated.sql
/apps/web/src/db/seeds/research-observations.json
/apps/web/src/db/seeds/research-external-evidence.json
/apps/web/src/db/seeds/research-store.sqlite
/apps/web/src/db/seeds/research-store.sqlite-*
/apps/web/src/db/seeds/research-artifacts/
/apps/web/src/db/seeds/reports/
!/apps/web/src/db/seeds/reports/
/apps/web/src/db/seeds/reports/*
!/apps/web/src/db/seeds/reports/company-insight-cards.json
!/apps/web/src/db/seeds/reports/company-indices.json
.research-browser/

# Python cache files from research database tooling
__pycache__/
*.py[cod]

# Local Codex/tooling work products
/.tmp-skill-upgrade/
/reports/model-review-*/

# Local DreamCanvas UI exports
/*.dc.html

# Local design QA captures (keep out of release commits)
/design-qa*.png
/design-qa.md

# cloudflare workers build output (opennextjs adapter)
/apps/web/.open-next/
/apps/web/.wrangler/
**/.dev.vars
**/.dev.vars.*
